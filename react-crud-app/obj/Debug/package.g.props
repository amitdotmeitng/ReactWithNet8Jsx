<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PackageJsonName Condition="$(PackageJsonName) == ''">react-crud-app</PackageJsonName>
    <PackageJsonVersion Condition="$(PackageJsonVersion) == ''">0.1.0</PackageJsonVersion>
    <PackageJsonPrivate Condition="$(PackageJsonPrivate) == ''">true</PackageJsonPrivate>
    <PackageJsonDependenciesTestingLibraryJestDom Condition="$(PackageJsonDependenciesTestingLibraryJestDom) == ''">^4.2.4</PackageJsonDependenciesTestingLibraryJestDom>
    <PackageJsonDependenciesTestingLibraryReact Condition="$(PackageJsonDependenciesTestingLibraryReact) == ''">^9.5.0</PackageJsonDependenciesTestingLibraryReact>
    <PackageJsonDependenciesTestingLibraryUserEvent Condition="$(PackageJsonDependenciesTestingLibraryUserEvent) == ''">^7.2.1</PackageJsonDependenciesTestingLibraryUserEvent>
    <PackageJsonDependenciesAxios Condition="$(PackageJsonDependenciesAxios) == ''">^0.27.2</PackageJsonDependenciesAxios>
    <PackageJsonDependenciesBootstrap Condition="$(PackageJsonDependenciesBootstrap) == ''">^4.5.0</PackageJsonDependenciesBootstrap>
    <PackageJsonDependenciesReact Condition="$(PackageJsonDependenciesReact) == ''">^17.0.1</PackageJsonDependenciesReact>
    <PackageJsonDependenciesReactDom Condition="$(PackageJsonDependenciesReactDom) == ''">^17.0.1</PackageJsonDependenciesReactDom>
    <PackageJsonDependenciesReactRouterDom Condition="$(PackageJsonDependenciesReactRouterDom) == ''">^5.2.0</PackageJsonDependenciesReactRouterDom>
    <PackageJsonDependenciesReactScripts Condition="$(PackageJsonDependenciesReactScripts) == ''">^5.0.1</PackageJsonDependenciesReactScripts>
    <PackageJsonScriptsStart Condition="$(PackageJsonScriptsStart) == ''">react-scripts start</PackageJsonScriptsStart>
    <PackageJsonScriptsBuild Condition="$(PackageJsonScriptsBuild) == ''">react-scripts build</PackageJsonScriptsBuild>
    <PackageJsonScriptsTest Condition="$(PackageJsonScriptsTest) == ''">react-scripts test</PackageJsonScriptsTest>
    <PackageJsonScriptsEject Condition="$(PackageJsonScriptsEject) == ''">react-scripts eject</PackageJsonScriptsEject>
    <PackageJsonScriptsDev Condition="$(PackageJsonScriptsDev) == ''">react-scripts start</PackageJsonScriptsDev>
    <PackageJsonEslintconfigExtends Condition="$(PackageJsonEslintconfigExtends) == ''">react-app</PackageJsonEslintconfigExtends>
    <PackageJsonBrowserslistProduction Condition="$(PackageJsonBrowserslistProduction) == ''">[
  "\u003E0.2%",
  "not dead",
  "not op_mini all"
]</PackageJsonBrowserslistProduction>
    <PackageJsonBrowserslistDevelopment Condition="$(PackageJsonBrowserslistDevelopment) == ''">[
  "last 1 chrome version",
  "last 1 firefox version",
  "last 1 safari version"
]</PackageJsonBrowserslistDevelopment>
  </PropertyGroup>
</Project>